@startuml FreshSenseDevice
skinparam classAttributeIconSize 0

class ClimateSensor {
  + begin()
  + read(temperatureC, humidityPct) : bool
}

class EthyleneSensor {
  + begin()
  + readPpm() : float
}

class SensorReading {
  + deviceId : String
  + timestamp : String
  + temperatureC : float
  + humidityPct : float
  + ethylenePpm : float
  + meta : String
  + isValid() : bool
  + toJson() : String
}

class ReadingClock {
  + begin()
  + stamp() : String
}

class DeviceLink {
  + connectWifi() : bool
  + postReading(payload) : int
  + postHeartbeat(payload) : int
}

class FreshSenseNode {
  + begin()
  + tick()
}

FreshSenseNode *-- ClimateSensor
FreshSenseNode *-- EthyleneSensor
FreshSenseNode *-- ReadingClock
FreshSenseNode *-- DeviceLink
FreshSenseNode ..> SensorReading

note right of SensorReading
  Informe 4.2.7.
  El servidor evalua umbrales
  y emite las alertas.
end note
@enduml
