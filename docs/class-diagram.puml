@startuml FreshSenseDevice
skinparam classAttributeIconSize 0

class ClimateSensor {
  + begin()
  + read(temperatureC, humidityPct) : bool
}

class EthyleneSensor {
  + begin()
  + readPpm() : float
}

class SensorReading {
  + deviceId : String
  + timestamp : String
  + temperatureC : float
  + humidityPct : float
  + ethylenePpm : float
  + meta : String
  + isValid() : bool
  + toJson() : String
}

class ReadingClock {
  + begin()
  + stamp() : String
}

class AlertActuators {
  + begin()
  + setAlert(active)
  + tick()
}

class ColdRoomFan {
  + begin()
  + setRunning(running)
}

class DeviceLink {
  + connectWifi() : bool
  + postReading(payload) : int
  + postHeartbeat(payload) : int
}

class FreshSenseNode {
  + begin()
  + tick()
}

FreshSenseNode *-- ClimateSensor
FreshSenseNode *-- EthyleneSensor
FreshSenseNode *-- AlertActuators
FreshSenseNode *-- ColdRoomFan
FreshSenseNode *-- ReadingClock
FreshSenseNode *-- DeviceLink
FreshSenseNode ..> SensorReading

note right of AlertActuators
  HIGH_ETHYLENE, por encima de 20 ppm.
  LED rojo fijo y bocina intermitente.
end note

note right of ColdRoomFan
  TEMP_RISK, por encima de 8 C.
  El rele enciende el ventilador.
end note
@enduml
